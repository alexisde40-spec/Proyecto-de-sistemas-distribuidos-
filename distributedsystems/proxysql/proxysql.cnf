datadir="/var/lib/proxysql"

admin_variables={
  admin_credentials="admin:admin"
  mysql_ifaces="0.0.0.0:6032"
}

mysql_variables={
  threads=4
  max_connections=2048
  default_query_delay=0
  default_query_timeout=36000000
  have_compress=true
  poll_timeout=2000
  interfaces="0.0.0.0:6033"
  default_schema="information_schema"
  server_version="11.4.7-MariaDB"
  connect_timeout_server=3000
  monitor_username="root"
  monitor_password="change-this-root-password"
  monitor_history=600000
  monitor_connect_interval=60000
  monitor_ping_interval=10000
  ping_interval_server_msec=120000
  ping_timeout_server=500
  commands_stats=true
  sessions_sort=true
  connect_retries_on_failure=10
}

mysql_servers = (
  { address="galera1", port=3306, hostgroup=10, max_connections=100 },
  { address="galera2", port=3306, hostgroup=20, max_connections=100 },
  { address="galera3", port=3306, hostgroup=20, max_connections=100 }
)

mysql_users = (
  { username="store_app", password="change-this-catalog-password", default_hostgroup=10, active=1, transaction_persistent=1 }
)

mysql_query_rules = (
  { rule_id=1, active=1, match_digest="^SELECT", destination_hostgroup=20, apply=1, cache_ttl=1000 },
  { rule_id=2, active=1, match_digest=".*", destination_hostgroup=10, apply=1 }
)

mysql_replication_hostgroups = (
  { writer_hostgroup=10, reader_hostgroup=20, comment="galera cluster" }
)
